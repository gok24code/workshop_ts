# Yönetim paneli (/admin) şifresi — en az 12 karakter, tahmin edilemez olmalı
# Üretmek için: openssl rand -base64 24
ADMIN_PASSWORD=

# Yönetici oturum süresi (dakika). Varsayılan 120.
ADMIN_SESSION_MINUTES=120

# Oturum çerezlerini imzalayan sunucu anahtarı — en az 32 karakter
# Üretmek için: openssl rand -base64 48
SESSION_SECRET=

# Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wts
